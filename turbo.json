{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV",
        "API_PORT",
        "API_HOST",
        "WEB_PORT",
        "ADMIN_API_PORT",
        "ADMIN_API_HOST",
        "ADMIN_WEB_PORT",
        "APP_ORIGIN",
        "CORS_ORIGINS",
        "ADMIN_CORS_ORIGINS",
        "DATABASE_URL",
        "SHADOW_DATABASE_URL",
        "REDIS_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_FORCE_PATH_STYLE",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "ADMIN_BETTER_AUTH_URL",
        "COOKIE_SECURE",
        "MAIL_FROM",
        "SMTP_URL",
        "DOCLING_URL",
        "NORMATIVE_RAG_ENABLED",
        "OPENAI_API_KEY",
        "OPENAI_PROFILE_MODEL",
        "OPENAI_REGULATORY_MODEL",
        "OPENAI_TRANSCRIPTION_MODEL",
        "EMBEDDING_BATCH_SIZE",
        "LOG_LEVEL",
        "MAX_UPLOAD_BYTES",
        "VITE_API_URL",
        "VITE_ADMIN_API_URL",
        "VITE_DEFAULT_LOCALE"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "coverage/**", ".vite/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
