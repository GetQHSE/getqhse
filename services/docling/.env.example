DOCLING_HOST=0.0.0.0
DOCLING_PORT=8000
DOCLING_MAX_UPLOAD_BYTES=20971520
DOCLING_ALLOWED_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
# Tesseract language packs installed in the extractor image. Docling's automatic OCR engine
# selection defaults to European languages only, so Arabic sources need this set explicitly.
DOCLING_OCR_LANGUAGES=fra+ara
# The converter holds model state that is not safe to drive from several threads at once.
DOCLING_MAX_CONCURRENT_CONVERSIONS=1
# Re-convert a PDF with full-page OCR when its own text layer decodes to nothing usable.
DOCLING_REPAIR_DEGENERATE_TEXT_LAYER=true
# Infer section-header depth from PDF bookmarks, outline numbering and font size.
DOCLING_INFER_HEADING_HIERARCHY=true
DOCLING_FALLBACK_OCR_DPI=300
