{
  "name": "@qhse/admin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "documents:reset": "tsx src/scripts/reset-documents.ts",
    "normative:index": "tsx src/scripts/normative-index.ts",
    "openapi:generate": "tsx src/openapi.ts && prettier --write openapi.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.36",
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/s3-request-presigner": "^3.1098.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@qhse/auth": "workspace:*",
    "@qhse/config": "workspace:*",
    "@qhse/contracts": "workspace:*",
    "@qhse/database": "workspace:*",
    "@qhse/domain": "workspace:*",
    "@qhse/documents": "workspace:*",
    "@qhse/knowledge": "workspace:*",
    "@qhse/observability": "workspace:*",
    "ai": "^7.0.58",
    "better-auth": "^1.6.25",
    "bullmq": "^5.81.3",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
