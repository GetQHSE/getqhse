    "/v1/platform-users": {
      "get": {
        "operationId": "PlatformUsersController_list",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": ["active", "suspended"],
              "type": "string"
            }
          },
          {
            "name": "role",
            "required": false,
            "in": "query",
            "schema": {
              "enum": ["platform_admin", "content_manager", "support"],
              "type": "string"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": ["platform-users"]
      },
      "post": {
        "operationId": "PlatformUsersController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["firstName", "lastName", "email", "password", "platformRole"],
                "properties": {
                  "firstName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "lastName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 320
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 12,
                    "maxLength": 128
                  },
                  "platformRole": {
                    "type": "string",
                    "enum": ["platform_admin", "content_manager", "support"]
                  },
                  "locale": {
                    "type": "string",
                    "default": "fr-MA"
                  },
                  "timezone": {
                    "type": "string",
                    "default": "Africa/Casablanca"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": ["platform-users"]
      }
    },
