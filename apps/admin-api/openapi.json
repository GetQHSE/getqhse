                  },
                  "platformRole": {
                    "type": "string",
                    "enum": ["platform_admin", "content_manager", "support"]
                  },
                  "status": {
                    "type": "string",
                    "enum": ["active", "suspended"]
                  },
                  "locale": {
                    "type": "string"
                  },
                  "timezone": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
