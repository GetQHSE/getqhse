                    "type": "string",
                    "format": "email",
                    "maxLength": 320
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 12,
                    "maxLength": 128
                  },
                  "platformRole": {
                    "type": "string",
                    "enum": ["platform_admin", "content_manager", "support"]
                  },
                  "locale": {
                    "type": "string",
                    "default": "fr-MA"
                  },
                  "timezone": {
                    "type": "string",
                    "default": "Africa/Casablanca"
