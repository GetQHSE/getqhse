    "@nestjs/core": "^11.1.28",
    "@qhse/config": "workspace:*",
    "@qhse/ai": "workspace:*",
    "@qhse/contracts": "workspace:*",
    "@qhse/database": "workspace:*",
    "@qhse/domain": "workspace:*",
    "@qhse/documents": "workspace:*",
    "@qhse/knowledge": "workspace:*",
    "@qhse/notifications": "workspace:*",
    "@qhse/observability": "workspace:*",
    "ai": "^7.0.58",
    "bullmq": "^5.81.3",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
