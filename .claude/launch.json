{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@qhse/admin-web", "dev"],
      "port": 5174
    },
    {
      "name": "client-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@qhse/client-web", "dev"],
      "port": 5173
    },
    {
      "name": "client-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "dotenv",
        "-e",
        ".env",
        "--",
        "pnpm",
        "--filter",
        "@qhse/client-api",
        "dev"
      ],
      "port": 3000
    }
  ]
}
