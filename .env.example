NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
WEB_PORT=5173
ADMIN_API_PORT=3001
ADMIN_API_HOST=0.0.0.0
ADMIN_WEB_PORT=5174
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
ADMIN_CORS_ORIGINS=http://localhost:5174
DATABASE_URL=postgresql://qhse_app:change-me@localhost:5432/qhse
MIGRATION_DATABASE_URL=postgresql://qhse_migrator:change-me@localhost:5432/qhse
# SHADOW_DATABASE_URL is optional: set it only if your Postgres user cannot
# CREATE DATABASE (Prisma otherwise manages the shadow DB itself).
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=qhse-files
S3_DOCUMENTS_BUCKET=qhse-files
S3_ACCESS_KEY=local-access-key
S3_SECRET_KEY=local-secret-key
S3_FORCE_PATH_STYLE=true
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
ADMIN_BETTER_AUTH_URL=http://localhost:3001
COOKIE_SECURE=false
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change-this-local-admin-password
BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com/v3
DOCLING_URL=http://localhost:8000
LOG_LEVEL=info

# Observability. The apps export logs and traces over OTLP to the Alloy
# collector from `pnpm obs:up`; Grafana is at http://localhost:3001.
# Set LOG_OTLP=false to keep logs on stdout only when the stack is not running.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_OTLP=true
MAX_UPLOAD_BYTES=10485760
DOCUMENT_MAX_UPLOAD_BYTES=52428800
DOCUMENT_WORKER_VERSION=mock-1
DOCUMENT_OCR_PROVIDER=mock
MALWARE_SCANNER_PROVIDER=mock
# Everything from here to OPENAI_REGULATORY_FLEX_RATE_MULTIPLIER is the fallback layer for the
# LLM settings the administration workspace edits (Settings -> LLM). A value saved there wins;
# generic LLM_* values win over the legacy OPENAI_* model values.
NORMATIVE_RAG_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_PROFILE_PROVIDER=openai
LLM_PROFILE_MODEL=gpt-5-mini
LLM_EMBEDDING_PROVIDER=openai
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_REGULATORY_PROVIDER=openai
LLM_REGULATORY_MODEL=gpt-5-mini
REGULATORY_WEB_SEARCH_ENABLED=true
# Records every candidate as APPLICABLE by an explicit SYSTEM decision instead of asking a
# person to decide law by law. The applicability review screen is hidden while this is true.
REGULATORY_AUTO_APPLICABLE=true
LLM_REGULATORY_VERIFICATION_PROVIDER=openai
LLM_REGULATORY_VERIFICATION_MODEL=gpt-5-nano
LLM_CUSTOM_MODELS_JSON=[]
ANTHROPIC_EFFORT=low
ANTHROPIC_SPEED=standard
GOOGLE_THINKING_LEVEL=low
# GOOGLE_THINKING_BUDGET=1024
OPENAI_PROFILE_MODEL=gpt-5-mini
OPENAI_REGULATORY_MODEL=gpt-5-mini
OPENAI_REGULATORY_VERIFICATION_MODEL=gpt-5-nano
REGULATORY_CONSERVATIVE_BYTES_PER_TOKEN=2
OPENAI_REGULATORY_SERVICE_TIER=flex
OPENAI_REGULATORY_TEXT_VERBOSITY=low
OPENAI_REGULATORY_PROMPT_CACHE_RETENTION=24h
OPENAI_REGULATORY_REASONING_EFFORT=low
OPENAI_REGULATORY_TIMEOUT_MS=180000
OPENAI_REGULATORY_DRAFT_MAX_OUTPUT_TOKENS=12000
OPENAI_REGULATORY_VERIFICATION_MAX_OUTPUT_TOKENS=10000
OPENAI_REGULATORY_RUN_BUDGET_USD=1
REGULATORY_EVALUATION_BUDGET_USD=10
OPENAI_REGULATORY_INPUT_USD_PER_MTOK=0.25
OPENAI_REGULATORY_CACHED_INPUT_USD_PER_MTOK=0.025
OPENAI_REGULATORY_OUTPUT_USD_PER_MTOK=2
OPENAI_REGULATORY_FLEX_RATE_MULTIPLIER=0.5
WORKER_HOST=127.0.0.1
WORKER_PORT=4002
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
EMBEDDING_BATCH_SIZE=64
SERVICE_NAME=qhse-platform
VITE_API_URL=http://localhost:3000
VITE_ADMIN_API_URL=http://localhost:3001
VITE_DEFAULT_LOCALE=fr
# Mirrors REGULATORY_AUTO_APPLICABLE: publishes findings without a review screen when true.
VITE_REGULATORY_AUTO_APPLICABLE=true

# Optional integration and end-to-end test configuration
TESTCONTAINERS_ENABLED=false
OPENAI_LIVE_TESTS=false
DOCLING_INTEGRATION_URL=http://localhost:8000
E2E_BASE_URL=http://localhost:5173
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_ADMIN_BASE_URL=http://localhost:5174
E2E_ADMIN_USER_EMAIL=
E2E_ADMIN_USER_PASSWORD=
