    "@qhse/database": "workspace:*",
    "@qhse/profile": "workspace:*",
    "ai": "^7.0.58",
    "better-auth": "^1.6.25",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "testcontainers": "^12.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
