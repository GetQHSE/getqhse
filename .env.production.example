# Public routes
BASE_DOMAIN=example.com
APP_ORIGIN=https://app.example.com
CORS_ORIGINS=https://app.example.com
BETTER_AUTH_URL=https://api.example.com
ADMIN_CORS_ORIGINS=https://admin.example.com
ADMIN_BETTER_AUTH_URL=https://admin-api.example.com
VITE_API_URL=https://api.example.com
VITE_ADMIN_API_URL=https://admin-api.example.com
VITE_DEFAULT_LOCALE=fr

# Dokploy-managed data services
DATABASE_URL=postgresql://qhse_app:replace-me@postgres-host:5432/qhse
REDIS_URL=redis://:replace-me@redis-host:6379
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=qhse-files
S3_DOCUMENTS_BUCKET=qhse-files
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_FORCE_PATH_STYLE=true

# Authentication and initial one-time bootstrap
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=replace-with-a-strong-one-time-password

# Application behavior
NORMATIVE_RAG_ENABLED=false
OPENAI_API_KEY=
OPENAI_PROFILE_MODEL=gpt-5-mini
OPENAI_REGULATORY_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
EMBEDDING_BATCH_SIZE=64
LOG_LEVEL=info

# Observability. Point this at the separately managed collector; telemetry is
# off entirely when OTEL_SDK_DISABLED=true.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
LOG_OTLP=true
MAX_UPLOAD_BYTES=10485760
DOCUMENT_MAX_UPLOAD_BYTES=52428800
DOCUMENT_WORKER_VERSION=production-1
DOCUMENT_OCR_PROVIDER=docling
MALWARE_SCANNER_PROVIDER=mock
DOCLING_MAX_UPLOAD_BYTES=52428800
DOCLING_ALLOWED_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Email delivery
MAIL_FROM=no-reply@example.com
SMTP_URL=smtps://replace-me:replace-me@smtp.example.com:465

# Resource limits; tune these to the VPS capacity
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1G
ADMIN_API_CPU_LIMIT=1.0
ADMIN_API_MEMORY_LIMIT=1G
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=2G
DOCLING_CPU_LIMIT=4.0
DOCLING_MEMORY_LIMIT=8G
WEB_CPU_LIMIT=0.5
WEB_MEMORY_LIMIT=256M
ADMIN_WEB_CPU_LIMIT=0.5
ADMIN_WEB_MEMORY_LIMIT=256M
