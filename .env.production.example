# Public routes
BASE_DOMAIN=example.com
APP_ORIGIN=https://app.example.com
CORS_ORIGINS=https://app.example.com
BETTER_AUTH_URL=https://api.example.com
ADMIN_CORS_ORIGINS=https://admin.example.com
ADMIN_BETTER_AUTH_URL=https://admin-api.example.com
VITE_API_URL=https://api.example.com
VITE_ADMIN_API_URL=https://admin-api.example.com
VITE_DEFAULT_LOCALE=fr

# Dokploy-managed data services
DATABASE_URL=postgresql://qhse_app:replace-me@postgres-host:5432/qhse
MIGRATION_DATABASE_URL=postgresql://qhse_migrator:replace-me@postgres-host:5432/qhse
REDIS_URL=redis://:replace-me@redis-host:6379
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=qhse-files
S3_DOCUMENTS_BUCKET=qhse-files
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_FORCE_PATH_STYLE=true

# Authentication and initial one-time bootstrap
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=replace-with-a-strong-one-time-password

# Application behavior
NORMATIVE_RAG_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_PROFILE_PROVIDER=openai
LLM_PROFILE_MODEL=gpt-5-mini
LLM_EMBEDDING_PROVIDER=openai
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_REGULATORY_PROVIDER=openai
LLM_REGULATORY_MODEL=gpt-5-mini
LLM_REGULATORY_VERIFICATION_PROVIDER=openai
LLM_REGULATORY_VERIFICATION_MODEL=gpt-5-nano
LLM_CUSTOM_MODELS_JSON=[]
ANTHROPIC_EFFORT=low
ANTHROPIC_SPEED=standard
GOOGLE_THINKING_LEVEL=low
# GOOGLE_THINKING_BUDGET=1024
OPENAI_PROFILE_MODEL=gpt-5-mini
OPENAI_REGULATORY_MODEL=gpt-5-mini
OPENAI_REGULATORY_VERIFICATION_MODEL=gpt-5-nano
REGULATORY_CONSERVATIVE_BYTES_PER_TOKEN=2
OPENAI_REGULATORY_SERVICE_TIER=flex
OPENAI_REGULATORY_TEXT_VERBOSITY=low
OPENAI_REGULATORY_PROMPT_CACHE_RETENTION=24h
OPENAI_REGULATORY_REASONING_EFFORT=low
OPENAI_REGULATORY_TIMEOUT_MS=180000
OPENAI_REGULATORY_DRAFT_MAX_OUTPUT_TOKENS=12000
OPENAI_REGULATORY_VERIFICATION_MAX_OUTPUT_TOKENS=6000
OPENAI_REGULATORY_RUN_BUDGET_USD=1
OPENAI_REGULATORY_INPUT_USD_PER_MTOK=0.25
OPENAI_REGULATORY_CACHED_INPUT_USD_PER_MTOK=0.025
OPENAI_REGULATORY_OUTPUT_USD_PER_MTOK=2
OPENAI_REGULATORY_FLEX_RATE_MULTIPLIER=0.5
WORKER_HOST=0.0.0.0
WORKER_PORT=4002
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
EMBEDDING_BATCH_SIZE=64
LOG_LEVEL=info

# Observability. Point this at the separately managed collector; telemetry is
# off entirely when OTEL_SDK_DISABLED=true.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
LOG_OTLP=true
MAX_UPLOAD_BYTES=10485760
DOCUMENT_MAX_UPLOAD_BYTES=52428800
DOCUMENT_WORKER_VERSION=production-1
DOCUMENT_OCR_PROVIDER=docling
MALWARE_SCANNER_PROVIDER=mock
DOCLING_MAX_UPLOAD_BYTES=52428800
DOCLING_ALLOWED_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
DOCLING_OCR_LANGUAGES=fra+ara
DOCLING_MAX_CONCURRENT_CONVERSIONS=1
DOCLING_REPAIR_DEGENERATE_TEXT_LAYER=true
DOCLING_INFER_HEADING_HIERARCHY=true
DOCLING_FALLBACK_OCR_DPI=300

# Brevo transactional email. The API key may instead be stored encrypted from Admin → Settings → Emails.
BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com/v3

# Resource limits; tune these to the VPS capacity
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1G
ADMIN_API_CPU_LIMIT=1.0
ADMIN_API_MEMORY_LIMIT=1G
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=2G
DOCLING_CPU_LIMIT=4.0
DOCLING_MEMORY_LIMIT=8G
WEB_CPU_LIMIT=0.5
WEB_MEMORY_LIMIT=256M
ADMIN_WEB_CPU_LIMIT=0.5
ADMIN_WEB_MEMORY_LIMIT=256M
