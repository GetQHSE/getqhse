}

enum ReviewIssueSeverity {
  LOW
  MEDIUM
  HIGH
  BLOCKING
}

enum ReviewIssueStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  firstName     String?  @map("first_name")
  lastName      String?  @map("last_name")
  status        String   @default("active")
  locale        String   @default("fr-MA")
  timezone      String   @default("Africa/Casablanca")
  platformRole  String   @default("user") @map("platform_role")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  accounts                            Account[]
  sessions                            Session[]
  members                             Member[]
  invitations                         Invitation[]                       @relation("InvitationInviter")
  assignedActions                     CorrectiveAction[]                 @relation("ActionAssignee")
  documentsCreated                    Document[]                         @relation("DocumentCreator")
  documentsUpdated                    Document[]                         @relation("DocumentUpdater")
  documentsPublished                  Document[]                         @relation("DocumentPublisher")
  documentVersionsCreated             DocumentVersion[]                  @relation("DocumentVersionCreator")
  documentVersionsValidated           DocumentVersion[]                  @relation("DocumentVersionValidator")
  documentVersionsPublished           DocumentVersion[]                  @relation("DocumentVersionPublisher")
  documentFilesUploaded               DocumentFile[]                     @relation("DocumentFileUploader")
  profileFieldsConfirmed              ProjectProfileField[]              @relation("ProfileFieldConfirmer")
  profileFieldRevisions               ProjectProfileFieldRevision[]      @relation("ProfileFieldRevisionActor")
  profileSnapshotsCreated             ProjectProfileSnapshot[]           @relation("ProfileSnapshotCreator")
  profileConversationsCreated         ProjectProfileConversation[]       @relation("ProfileConversationCreator")
  filesUploaded                       FileObject[]                       @relation("FileUploader")
  documentRelationshipsCreated        DocumentRelationship[]             @relation("DocumentRelationshipCreator")
  documentClassificationsValidated    DocumentTaxonomyTerm[]             @relation("DocumentTaxonomyValidator")
  documentMetadataSuggestionsReviewed DocumentMetadataSuggestion[]       @relation("DocumentMetadataSuggestionReviewer")
  documentReviewsAssigned             DocumentReview[]                   @relation("DocumentReviewAssignee")
  documentReviewsCreated              DocumentReview[]                   @relation("DocumentReviewCreator")
  documentReviewIssuesAssigned        DocumentReviewIssue[]              @relation("DocumentReviewIssueAssignee")
  documentReviewIssuesCreated         DocumentReviewIssue[]              @relation("DocumentReviewIssueCreator")
  documentReviewIssuesResolved        DocumentReviewIssue[]              @relation("DocumentReviewIssueResolver")
  documentActivities                  DocumentActivity[]                 @relation("DocumentActivityActor")
  createdProjects                     Project[]                          @relation("ProjectCreator")
  regulatoryAnalysesCreated           RegulatoryAnalysisRun[]            @relation("RegulatoryAnalysisCreator")
  regulatoryCandidatesReviewed        RegulatoryApplicabilityCandidate[] @relation("RegulatoryCandidateReviewer")
  regulatoryRequirementsEdited        RegulatoryApplicabilityCandidate[] @relation("RegulatoryRequirementEditor")
  regulatoryAnalysisReviews           RegulatoryAnalysisReview[]         @relation("RegulatoryAnalysisReviewer")
  regulatoryBaselinesPublished        RegulatoryBaseline[]               @relation("RegulatoryBaselinePublisher")
  regulatoryRequirementsReviewed      RegulatoryRegisterEntry[]          @relation("RegulatoryRequirementReviewer")
  emailSettingsUpdated                EmailSetting[]                     @relation("EmailSettingUpdater")
  emailDeliveriesReceived             EmailDelivery[]                    @relation("EmailDeliveryRecipient")
  regulatoryEvaluationsCompleted      RegulatoryEvaluation[]             @relation("RegulatoryEvaluationReviewer")
  regulatoryEvidenceCreated           RegulatoryEvaluationEvidence[]     @relation("RegulatoryEvidenceCreator")
  regulatoryActionsAssigned           RegulatoryEvaluationAction[]       @relation("RegulatoryActionAssignee")
  regulatorySyncEventsCreated         RegulatorySyncEvent[]              @relation("RegulatorySyncEventActor")
  llmSettingsUpdated                  LlmSetting[]                       @relation("LlmSettingUpdatedBy")
  aiKnowledgeCreated                  AiKnowledgeExample[]               @relation("AiKnowledgeCreatedBy")
  aiKnowledgeUpdated                  AiKnowledgeExample[]               @relation("AiKnowledgeUpdatedBy")
  aiKnowledgeActivity                 AiKnowledgeActivity[]              @relation("AiKnowledgeActivityActor")
  contextSettingsUpdated              ProjectContextSettings[]           @relation("ContextSettingsUpdater")
  contextInternalInputsCreated        ContextInternalInput[]             @relation("ContextInternalInputCreator")
  contextInternalInputsUpdated        ContextInternalInput[]             @relation("ContextInternalInputUpdater")
  contextExternalRunsTriggered        ContextExternalResearchRun[]       @relation("ContextExternalRunTrigger")
  contextAnalysisRunsTriggered        ContextAnalysisRun[]               @relation("ContextAnalysisRunTrigger")
  contextIssuesReviewed               ContextIssue[]                     @relation("ContextIssueReviewer")
  contextIssuesCreated                ContextIssue[]                     @relation("ContextIssueCreator")
  contextIssueEvidenceCreated         ContextIssueEvidence[]             @relation("ContextIssueEvidenceCreator")
  contextIssueCorrectionsAuthored     ContextIssueCorrection[]           @relation("ContextIssueCorrectionAuthor")

  @@map("users")
}

model Document {
  id                   String             @id @default(cuid())
  title                String
  shortTitle           String?            @map("short_title")
  description          String?
  documentType         String             @map("document_type")
  sourceType           String             @map("source_type")
  jurisdiction         String?
  countryCode          String?            @map("country_code")
  language             String
  issuingAuthority     String?            @map("issuing_authority")
  referenceNumber      String?            @map("reference_number")
  publicationDate      DateTime?          @map("publication_date") @db.Date
  effectiveDate        DateTime?          @map("effective_date") @db.Date
  expirationDate       DateTime?          @map("expiration_date") @db.Date
  status               DocumentStatus     @default(DRAFT)
  visibility           DocumentVisibility @default(PLATFORM_INTERNAL)
  currentVersionId     String?            @unique @map("current_version_id")
  supersedesDocumentId String?            @map("supersedes_document_id")
  replacedByDocumentId String?            @map("replaced_by_document_id")
  createdByUserId      String             @map("created_by_user_id")
  updatedByUserId      String             @map("updated_by_user_id")
  publishedByUserId    String?            @map("published_by_user_id")
  publishedAt          DateTime?          @map("published_at")
  archivedAt           DateTime?          @map("archived_at")
  deletedAt            DateTime?          @map("deleted_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  currentVersion        DocumentVersion?       @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  supersedesDocument    Document?              @relation("DocumentSupersession", fields: [supersedesDocumentId], references: [id], onDelete: SetNull)
  supersededByDocuments Document[]             @relation("DocumentSupersession")
  replacedByDocument    Document?              @relation("DocumentReplacement", fields: [replacedByDocumentId], references: [id], onDelete: SetNull)
  replacementDocuments  Document[]             @relation("DocumentReplacement")
  createdBy             User                   @relation("DocumentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy             User                   @relation("DocumentUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  publishedBy           User?                  @relation("DocumentPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  versions              DocumentVersion[]      @relation("DocumentVersions")
  sourceRelationships   DocumentRelationship[] @relation("RelationshipSourceDocument")
  targetRelationships   DocumentRelationship[] @relation("RelationshipTargetDocument")
  taxonomyTerms         DocumentTaxonomyTerm[]
  activity              DocumentActivity[]
  regulatorySyncEvents  RegulatorySyncEvent[]

  @@index([status, updatedAt])
  @@index([documentType, countryCode])
  @@index([referenceNumber])
  @@map("documents")
}

model DocumentVersion {
  id                       String              @id @default(cuid())
  documentId               String              @map("document_id")
  versionNumber            Int                 @map("version_number")
  versionLabel             String              @map("version_label")
  revisionDate             DateTime?           @map("revision_date") @db.Date
  sourceEdition            String?             @map("source_edition")
  sourceUrl                String?             @map("source_url")
  effectiveDate            DateTime?           @map("effective_date") @db.Date
  expirationDate           DateTime?           @map("expiration_date") @db.Date
  changeSummary            String?             @map("change_summary")
  changeType               VersionChangeType   @map("change_type")
  status                   DocumentStatus      @default(UPLOADED)
  originalFileName         String              @map("original_file_name")
  mimeType                 String              @map("mime_type")
  fileExtension            String              @map("file_extension")
  fileSize                 BigInt              @map("file_size")
  storageKey               String              @unique @map("storage_key")
  fileHash                 String              @map("file_hash")
  pageCount                Int?                @map("page_count")
  wordCount                Int?                @map("word_count")
  characterCount           Int?                @map("character_count")
  extractionMethod         String?             @map("extraction_method")
  ocrUsed                  Boolean             @default(false) @map("ocr_used")
  ocrConfidence            Decimal?            @map("ocr_confidence") @db.Decimal(5, 4)
  processingStatus         ProcessingJobStatus @default(PENDING) @map("processing_status")
  processingError          String?             @map("processing_error")
  rawExtractedTextLocation String?             @map("raw_extracted_text_location")
  normalizedTextLocation   String?             @map("normalized_text_location")
  reviewStatus             ReviewStatus        @default(NOT_STARTED) @map("review_status")
  storageAllowed           Boolean             @default(false) @map("storage_allowed")
  extractionAllowed        Boolean             @default(false) @map("extraction_allowed")
  embeddingAllowed         Boolean             @default(false) @map("embedding_allowed")
  aiProcessingAllowed      Boolean             @default(false) @map("ai_processing_allowed")
  externalProviderAllowed  Boolean             @default(false) @map("external_provider_allowed")
  excerptDisplayAllowed    Boolean             @default(false) @map("excerpt_display_allowed")
  exportAllowed            Boolean             @default(false) @map("export_allowed")
  rightsReviewedAt         DateTime?           @map("rights_reviewed_at")
  supersedesVersionId      String?             @map("supersedes_version_id")
  chunkingVersion          String?             @map("chunking_version")
  createdByUserId          String              @map("created_by_user_id")
  validatedByUserId        String?             @map("validated_by_user_id")
  validatedAt              DateTime?           @map("validated_at")
  publishedByUserId        String?             @map("published_by_user_id")
  publishedAt              DateTime?           @map("published_at")
  archivedAt               DateTime?           @map("archived_at")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  document                 Document                     @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Restrict)
  currentFor               Document?                    @relation("CurrentDocumentVersion")
  supersedesVersion        DocumentVersion?             @relation("VersionSupersession", fields: [supersedesVersionId], references: [id], onDelete: SetNull)
  supersededByVersions     DocumentVersion[]            @relation("VersionSupersession")
  createdBy                User                         @relation("DocumentVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  validatedBy              User?                        @relation("DocumentVersionValidator", fields: [validatedByUserId], references: [id], onDelete: SetNull)
  publishedBy              User?                        @relation("DocumentVersionPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  files                    DocumentFile[]
  processingJobs           DocumentProcessingJob[]
  sections                 DocumentSection[]
  provisions               DocumentProvision[]
  chunks                   DocumentChunk[]
  metadataSuggestions      DocumentMetadataSuggestion[]
  reviews                  DocumentReview[]
  reviewIssues             DocumentReviewIssue[]
  sourceRelationships      DocumentRelationship[]       @relation("RelationshipSourceVersion")
  targetRelationships      DocumentRelationship[]       @relation("RelationshipTargetVersion")
  activity                 DocumentActivity[]
  regulatoryRunsTriggered  RegulatoryAnalysisRun[]      @relation("RegulatoryTriggerDocumentVersion")
  regulatorySyncEventsFrom RegulatorySyncEvent[]        @relation("RegulatorySyncPreviousVersion")
  regulatorySyncEventsTo   RegulatorySyncEvent[]        @relation("RegulatorySyncPublishedVersion")

  @@unique([documentId, versionNumber])
  @@unique([documentId, versionLabel])
  @@index([fileHash])
  @@index([status, processingStatus])
  @@map("document_versions")
}

model DocumentFile {
  id                String   @id @default(cuid())
  documentVersionId String   @map("document_version_id")
  fileRole          String   @map("file_role")
  originalFileName  String   @map("original_file_name")
  storageKey        String   @unique @map("storage_key")
  mimeType          String   @map("mime_type")
  fileExtension     String   @map("file_extension")
  fileSize          BigInt   @map("file_size")
  fileHash          String   @map("file_hash")
  uploadedByUserId  String   @map("uploaded_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")

  version    DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  uploadedBy User            @relation("DocumentFileUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([documentVersionId, fileHash, fileRole])
  @@index([fileHash])
  @@map("document_files")
}

model DocumentRelationship {
  id               String   @id @default(cuid())
  sourceDocumentId String   @map("source_document_id")
  sourceVersionId  String?  @map("source_version_id")
  targetDocumentId String   @map("target_document_id")
  targetVersionId  String?  @map("target_version_id")
  relationshipType String   @map("relationship_type")
  description      String?
  createdByUserId  String   @map("created_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  sourceDocument Document         @relation("RelationshipSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  sourceVersion  DocumentVersion? @relation("RelationshipSourceVersion", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  targetDocument Document         @relation("RelationshipTargetDocument", fields: [targetDocumentId], references: [id], onDelete: Restrict)
  targetVersion  DocumentVersion? @relation("RelationshipTargetVersion", fields: [targetVersionId], references: [id], onDelete: SetNull)
  createdBy      User             @relation("DocumentRelationshipCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([sourceDocumentId, sourceVersionId, targetDocumentId, targetVersionId, relationshipType])
  @@map("document_relationships")
}

model DocumentProcessingJob {
  id                      String              @id @default(cuid())
  documentVersionId       String              @map("document_version_id")
  jobType                 String              @map("job_type")
  status                  ProcessingJobStatus @default(PENDING)
  attemptCount            Int                 @default(0) @map("attempt_count")
  startedAt               DateTime?           @map("started_at")
  completedAt             DateTime?           @map("completed_at")
  errorCode               String?             @map("error_code")
  errorMessage            String?             @map("error_message")
  inputMetadata           Json?               @map("input_metadata")
  outputMetadata          Json?               @map("output_metadata")
  outputLocation          String?             @map("output_location")
  qualityScore            Decimal?            @map("quality_score") @db.Decimal(5, 4)
  workerVersion           String?             @map("worker_version")
  processingConfiguration Json?               @map("processing_configuration")
  idempotencyKey          String              @unique @map("idempotency_key")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  version      DocumentVersion       @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  reviewIssues DocumentReviewIssue[]

  @@index([status, jobType])
  @@index([documentVersionId, createdAt])
  @@map("document_processing_jobs")
}

model DocumentSection {
  id                String   @id @default(cuid())
  documentVersionId String   @map("document_version_id")
  parentSectionId   String?  @map("parent_section_id")
  sectionType       String   @map("section_type")
  sectionNumber     String?  @map("section_number")
  title             String?
  normalizedTitle   String?  @map("normalized_title")
  content           String
  pageStart         Int?     @map("page_start")
  pageEnd           Int?     @map("page_end")
  orderIndex        Int      @map("order_index")
  sourceLocation    Json?    @map("source_location")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  version    DocumentVersion     @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  parent     DocumentSection?    @relation("SectionTree", fields: [parentSectionId], references: [id], onDelete: Cascade)
  children   DocumentSection[]   @relation("SectionTree")
  chunks     DocumentChunk[]
  provisions DocumentProvision[]

  @@unique([documentVersionId, orderIndex])
  @@index([parentSectionId])
  @@map("document_sections")
}

model DocumentProvision {
  id                String                @id @default(cuid())
  documentVersionId String                @map("document_version_id")
  documentSectionId String?               @map("document_section_id")
  provisionType     DocumentProvisionType @map("provision_type")
  sourceIdentifier  String?               @map("source_identifier")
  title             String?
  headingPath       String[]              @default([]) @map("heading_path")
  language          String
  content           String
  contentHash       String                @map("content_hash")
  pageStart         Int?                  @map("page_start")
  pageEnd           Int?                  @map("page_end")
  sourceLocation    Json?                 @map("source_location")
  orderIndex        Int                   @map("order_index")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  version              DocumentVersion                    @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  section              DocumentSection?                   @relation(fields: [documentSectionId], references: [id], onDelete: SetNull)
  chunks               DocumentChunk[]
  regulatoryCandidates RegulatoryApplicabilityCandidate[]
  regulatoryEntries    RegulatoryRegisterEntry[]
  regulatoryModelCalls RegulatoryModelCall[]

  @@unique([documentVersionId, orderIndex])
  @@index([documentVersionId, sourceIdentifier])
  @@index([language, provisionType])
  @@map("document_provisions")
}

model DocumentChunk {
  id                  String              @id @default(cuid())
  documentVersionId   String              @map("document_version_id")
  documentSectionId   String?             @map("document_section_id")
  documentProvisionId String?             @map("document_provision_id")
  chunkIndex          Int                 @map("chunk_index")
  content             String
  searchText          String              @map("search_text")
  language            String
  headingPath         String[]            @default([]) @map("heading_path")
  tokenCount          Int                 @map("token_count")
  pageStart           Int?                @map("page_start")
  pageEnd             Int?                @map("page_end")
  sourceLocation      Json?               @map("source_location")
  contentHash         String              @map("content_hash")
  chunkingVersion     String              @map("chunking_version")
  embeddingStatus     ProcessingJobStatus @default(PENDING) @map("embedding_status")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  version    DocumentVersion     @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  section    DocumentSection?    @relation(fields: [documentSectionId], references: [id], onDelete: SetNull)
  provision  DocumentProvision?  @relation(fields: [documentProvisionId], references: [id], onDelete: SetNull)
  embeddings DocumentEmbedding[]

  @@unique([documentVersionId, chunkingVersion, chunkIndex])
  // Not unique: identical text legitimately repeats within one document
  // (recurring boilerplate, short repeated notes), and contentHash is
  // sha256(content) alone, so such chunks collide by construction.
  @@index([documentVersionId, chunkingVersion, contentHash])
  @@index([documentProvisionId])
  @@map("document_chunks")
}

model EmbeddingProfile {
  id          String                 @id @default(cuid())
  key         String                 @unique
  provider    String
  model       String
  dimensions  Int                    @default(768)
  version     Int
  status      EmbeddingProfileStatus @default(BUILDING)
  activatedAt DateTime?              @map("activated_at")
  retiredAt   DateTime?              @map("retired_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  embeddings          DocumentEmbedding[]
  knowledgeEmbeddings AiKnowledgeEmbedding[]
  retrievalLogs       RetrievalLog[]

  @@unique([provider, model, dimensions, version])
  @@index([status])
  @@map("embedding_profiles")
}

model DocumentEmbedding {
  id                 String                     @id @default(cuid())
  documentChunkId    String                     @map("document_chunk_id")
  embeddingProfileId String                     @map("embedding_profile_id")
  inputHash          String                     @map("input_hash")
  embedding          Unsupported("vector(768)")
  tokenCount         Int?                       @map("token_count")
  generatedAt        DateTime                   @default(now()) @map("generated_at")
