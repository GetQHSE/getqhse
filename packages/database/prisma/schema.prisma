  analyses        RegulatoryAnalysisRun[]
  baselines       RegulatoryBaseline[]    @relation("RegulatoryWatchBaselines")

  @@index([organizationId, status])
  @@map("project_regulatory_watches")
}

model RegulatoryAnalysisRun {
  id                       String                   @id @default(cuid())
  watchId                  String                   @map("watch_id")
  profileSnapshotId        String                   @map("profile_snapshot_id")
  createdById              String                   @map("created_by_id")
  baseBaselineId           String?                  @map("base_baseline_id")
  triggerType              RegulatoryRunTrigger     @default(MANUAL) @map("trigger_type")
  triggerKey               String                   @default(cuid()) @map("trigger_key")
  triggerDocumentVersionId String?                  @map("trigger_document_version_id")
  status                   RegulatoryAnalysisStatus @default(QUEUED)
  asOf                     DateTime                 @map("as_of") @db.Date
  languages                String[]                 @default(["fr", "ar"])
  phase                    String                   @default("queued")
  progressPercent          Int                      @default(0) @map("progress_percent")
  clarificationRevision    Int                      @default(0) @map("clarification_revision")
  model                    String?
  promptKey                String?                  @map("prompt_key")
  promptVersion            Int?                     @map("prompt_version")
  inputTokens              Int?                     @map("input_tokens")
  outputTokens             Int?                     @map("output_tokens")
  errorCode                String?                  @map("error_code")
  errorMessage             String?                  @map("error_message")
  startedAt                DateTime?                @map("started_at")
  completedAt              DateTime?                @map("completed_at")
  supersededAt             DateTime?                @map("superseded_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")

  watch                  ProjectRegulatoryWatch             @relation(fields: [watchId], references: [id], onDelete: Cascade)
  profileSnapshot        ProjectProfileSnapshot             @relation(fields: [profileSnapshotId], references: [id], onDelete: Restrict)
  createdBy              User                               @relation("RegulatoryAnalysisCreator", fields: [createdById], references: [id], onDelete: Restrict)
  baseBaseline           RegulatoryBaseline?                @relation("RegulatoryAnalysisBaseBaseline", fields: [baseBaselineId], references: [id], onDelete: Restrict)
  triggerDocumentVersion DocumentVersion?                   @relation("RegulatoryTriggerDocumentVersion", fields: [triggerDocumentVersionId], references: [id], onDelete: SetNull)
  scopeFacts             RegulatoryScopeFact[]
  candidates             RegulatoryApplicabilityCandidate[]
  baseline               RegulatoryBaseline?

  @@unique([watchId, triggerKey])
  @@index([watchId, createdAt])
  @@index([status, createdAt])
  @@map("regulatory_analysis_runs")
}

