generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum AuditStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum AssessmentResult {
  CONFORMING
  PARTIAL
  NON_CONFORMING
  NOT_ASSESSED
}

enum EvidenceKind {
  DOCUMENT
  PHOTO
  NOTE
  LINK
}

enum FindingSeverity {
  OBSERVATION
  MINOR
  MAJOR
  CRITICAL
}

enum FindingStatus {
  OPEN
  IN_PROGRESS
  VERIFIED
  CLOSED
}

enum CorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  VERIFIED
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
}

enum DocumentStatus {
  DRAFT
  UPLOADED
  PROCESSING
  REVIEW_REQUIRED
  VALIDATED
  PUBLISHED
  PROCESSING_FAILED
  ARCHIVED
}

enum DocumentVisibility {
  PLATFORM_INTERNAL
  ORGANIZATION_AVAILABLE
  PUBLIC_REFERENCE
  RESTRICTED
}

enum VersionChangeType {
  INITIAL
  MINOR_REVISION
  MAJOR_REVISION
  AMENDMENT
  CORRECTION
  REPLACEMENT
  TRANSLATION
}

enum ProcessingJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum ProjectEntityType {
  COMPANY
  SCHOOL
  UNIVERSITY
  INSTITUTION
  ASSOCIATION
  PUBLIC_ADMINISTRATION
  INDUSTRIAL_SITE
  OTHER
}

enum ProjectStatus {
  EMPTY
  PROFILE_IN_PROGRESS
  PROFILE_REVIEW
  READY_FOR_ANALYSIS
  ANALYSIS_IN_PROGRESS
  REVIEW_REQUIRED
  COMPLETED
  ARCHIVED
}

enum ReviewStatus {
  NOT_STARTED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum ReviewIssueSeverity {
  LOW
  MEDIUM
  HIGH
  BLOCKING
}

enum ReviewIssueStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  firstName     String?  @map("first_name")
  lastName      String?  @map("last_name")
  status        String   @default("active")
  locale        String   @default("fr-MA")
  timezone      String   @default("Africa/Casablanca")
  platformRole  String   @default("user") @map("platform_role")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  accounts                            Account[]
  sessions                            Session[]
  members                             Member[]
  invitations                         Invitation[]                 @relation("InvitationInviter")
  assignedActions                     CorrectiveAction[]           @relation("ActionAssignee")
  documentsCreated                    Document[]                   @relation("DocumentCreator")
  documentsUpdated                    Document[]                   @relation("DocumentUpdater")
  documentsPublished                  Document[]                   @relation("DocumentPublisher")
  documentVersionsCreated             DocumentVersion[]            @relation("DocumentVersionCreator")
  documentVersionsValidated           DocumentVersion[]            @relation("DocumentVersionValidator")
  documentVersionsPublished           DocumentVersion[]            @relation("DocumentVersionPublisher")
  documentFilesUploaded               DocumentFile[]               @relation("DocumentFileUploader")
  documentRelationshipsCreated        DocumentRelationship[]       @relation("DocumentRelationshipCreator")
  documentClassificationsValidated    DocumentTaxonomyTerm[]       @relation("DocumentTaxonomyValidator")
  documentMetadataSuggestionsReviewed DocumentMetadataSuggestion[] @relation("DocumentMetadataSuggestionReviewer")
  documentReviewsAssigned             DocumentReview[]             @relation("DocumentReviewAssignee")
  documentReviewsCreated              DocumentReview[]             @relation("DocumentReviewCreator")
  documentReviewIssuesAssigned        DocumentReviewIssue[]        @relation("DocumentReviewIssueAssignee")
  documentReviewIssuesCreated         DocumentReviewIssue[]        @relation("DocumentReviewIssueCreator")
  documentReviewIssuesResolved        DocumentReviewIssue[]        @relation("DocumentReviewIssueResolver")
  documentActivities                  DocumentActivity[]           @relation("DocumentActivityActor")
  createdProjects                    Project[]                    @relation("ProjectCreator")

  @@map("users")
}

model Document {
  id                   String             @id @default(cuid())
  title                String
  shortTitle           String?            @map("short_title")
  description          String?
  documentType         String             @map("document_type")
  sourceType           String             @map("source_type")
  jurisdiction         String?
  countryCode          String?            @map("country_code")
  language             String
  issuingAuthority     String?            @map("issuing_authority")
  referenceNumber      String?            @map("reference_number")
  publicationDate      DateTime?          @map("publication_date") @db.Date
  effectiveDate        DateTime?          @map("effective_date") @db.Date
  expirationDate       DateTime?          @map("expiration_date") @db.Date
  status               DocumentStatus     @default(DRAFT)
  visibility           DocumentVisibility @default(PLATFORM_INTERNAL)
  currentVersionId     String?            @unique @map("current_version_id")
  supersedesDocumentId String?            @map("supersedes_document_id")
  replacedByDocumentId String?            @map("replaced_by_document_id")
  createdByUserId      String             @map("created_by_user_id")
  updatedByUserId      String             @map("updated_by_user_id")
  publishedByUserId    String?            @map("published_by_user_id")
  publishedAt          DateTime?          @map("published_at")
  archivedAt           DateTime?          @map("archived_at")
  deletedAt            DateTime?          @map("deleted_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  currentVersion        DocumentVersion?       @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  supersedesDocument    Document?              @relation("DocumentSupersession", fields: [supersedesDocumentId], references: [id], onDelete: SetNull)
  supersededByDocuments Document[]             @relation("DocumentSupersession")
  replacedByDocument    Document?              @relation("DocumentReplacement", fields: [replacedByDocumentId], references: [id], onDelete: SetNull)
  replacementDocuments  Document[]             @relation("DocumentReplacement")
  createdBy             User                   @relation("DocumentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy             User                   @relation("DocumentUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  publishedBy           User?                  @relation("DocumentPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  versions              DocumentVersion[]      @relation("DocumentVersions")
  sourceRelationships   DocumentRelationship[] @relation("RelationshipSourceDocument")
  targetRelationships   DocumentRelationship[] @relation("RelationshipTargetDocument")
  taxonomyTerms         DocumentTaxonomyTerm[]
  activity              DocumentActivity[]

  @@index([status, updatedAt])
  @@index([documentType, countryCode])
  @@index([referenceNumber])
  @@map("documents")
}

model DocumentVersion {
  id                       String              @id @default(cuid())
  documentId               String              @map("document_id")
  versionNumber            Int                 @map("version_number")
  versionLabel             String              @map("version_label")
  revisionDate             DateTime?           @map("revision_date") @db.Date
  effectiveDate            DateTime?           @map("effective_date") @db.Date
  expirationDate           DateTime?           @map("expiration_date") @db.Date
  changeSummary            String?             @map("change_summary")
  changeType               VersionChangeType   @map("change_type")
  status                   DocumentStatus      @default(UPLOADED)
  originalFileName         String              @map("original_file_name")
  mimeType                 String              @map("mime_type")
  fileExtension            String              @map("file_extension")
  fileSize                 BigInt              @map("file_size")
  storageKey               String              @unique @map("storage_key")
  fileHash                 String              @map("file_hash")
  pageCount                Int?                @map("page_count")
  wordCount                Int?                @map("word_count")
  characterCount           Int?                @map("character_count")
  extractionMethod         String?             @map("extraction_method")
  ocrUsed                  Boolean             @default(false) @map("ocr_used")
  ocrConfidence            Decimal?            @map("ocr_confidence") @db.Decimal(5, 4)
  processingStatus         ProcessingJobStatus @default(PENDING) @map("processing_status")
  processingError          String?             @map("processing_error")
  rawExtractedTextLocation String?             @map("raw_extracted_text_location")
  normalizedTextLocation   String?             @map("normalized_text_location")
  reviewStatus             ReviewStatus        @default(NOT_STARTED) @map("review_status")
  supersedesVersionId      String?             @map("supersedes_version_id")
  chunkingVersion          String?             @map("chunking_version")
  createdByUserId          String              @map("created_by_user_id")
  validatedByUserId        String?             @map("validated_by_user_id")
  validatedAt              DateTime?           @map("validated_at")
  publishedByUserId        String?             @map("published_by_user_id")
  publishedAt              DateTime?           @map("published_at")
  archivedAt               DateTime?           @map("archived_at")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  document             Document                     @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Restrict)
  currentFor           Document?                    @relation("CurrentDocumentVersion")
  supersedesVersion    DocumentVersion?             @relation("VersionSupersession", fields: [supersedesVersionId], references: [id], onDelete: SetNull)
  supersededByVersions DocumentVersion[]            @relation("VersionSupersession")
  createdBy            User                         @relation("DocumentVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  validatedBy          User?                        @relation("DocumentVersionValidator", fields: [validatedByUserId], references: [id], onDelete: SetNull)
  publishedBy          User?                        @relation("DocumentVersionPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  files                DocumentFile[]
  processingJobs       DocumentProcessingJob[]
  sections             DocumentSection[]
  chunks               DocumentChunk[]
  metadataSuggestions  DocumentMetadataSuggestion[]
  reviews              DocumentReview[]
  reviewIssues         DocumentReviewIssue[]
  sourceRelationships  DocumentRelationship[]       @relation("RelationshipSourceVersion")
  targetRelationships  DocumentRelationship[]       @relation("RelationshipTargetVersion")
  activity             DocumentActivity[]

  @@unique([documentId, versionNumber])
  @@unique([documentId, versionLabel])
  @@index([fileHash])
  @@index([status, processingStatus])
  @@map("document_versions")
}

model DocumentFile {
  id                String   @id @default(cuid())
  documentVersionId String   @map("document_version_id")
  fileRole          String   @map("file_role")
  originalFileName  String   @map("original_file_name")
  storageKey        String   @unique @map("storage_key")
  mimeType          String   @map("mime_type")
  fileExtension     String   @map("file_extension")
  fileSize          BigInt   @map("file_size")
  fileHash          String   @map("file_hash")
  uploadedByUserId  String   @map("uploaded_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")

  version    DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  uploadedBy User            @relation("DocumentFileUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([documentVersionId, fileHash, fileRole])
  @@index([fileHash])
  @@map("document_files")
}

model DocumentRelationship {
  id               String   @id @default(cuid())
  sourceDocumentId String   @map("source_document_id")
  sourceVersionId  String?  @map("source_version_id")
  targetDocumentId String   @map("target_document_id")
  targetVersionId  String?  @map("target_version_id")
  relationshipType String   @map("relationship_type")
  description      String?
  createdByUserId  String   @map("created_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  sourceDocument Document         @relation("RelationshipSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  sourceVersion  DocumentVersion? @relation("RelationshipSourceVersion", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  targetDocument Document         @relation("RelationshipTargetDocument", fields: [targetDocumentId], references: [id], onDelete: Restrict)
  targetVersion  DocumentVersion? @relation("RelationshipTargetVersion", fields: [targetVersionId], references: [id], onDelete: SetNull)
  createdBy      User             @relation("DocumentRelationshipCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([sourceDocumentId, sourceVersionId, targetDocumentId, targetVersionId, relationshipType])
  @@map("document_relationships")
}

model DocumentProcessingJob {
  id                      String              @id @default(cuid())
  documentVersionId       String              @map("document_version_id")
  jobType                 String              @map("job_type")
  status                  ProcessingJobStatus @default(PENDING)
  attemptCount            Int                 @default(0) @map("attempt_count")
  startedAt               DateTime?           @map("started_at")
  completedAt             DateTime?           @map("completed_at")
  errorCode               String?             @map("error_code")
  errorMessage            String?             @map("error_message")
  inputMetadata           Json?               @map("input_metadata")
  outputMetadata          Json?               @map("output_metadata")
  outputLocation          String?             @map("output_location")
  qualityScore            Decimal?            @map("quality_score") @db.Decimal(5, 4)
  workerVersion           String?             @map("worker_version")
  processingConfiguration Json?               @map("processing_configuration")
  idempotencyKey          String              @unique @map("idempotency_key")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  version      DocumentVersion       @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  reviewIssues DocumentReviewIssue[]

  @@index([status, jobType])
  @@index([documentVersionId, createdAt])
  @@map("document_processing_jobs")
}

model DocumentSection {
  id                String   @id @default(cuid())
  documentVersionId String   @map("document_version_id")
  parentSectionId   String?  @map("parent_section_id")
  sectionType       String   @map("section_type")
  sectionNumber     String?  @map("section_number")
  title             String?
  normalizedTitle   String?  @map("normalized_title")
  content           String
  pageStart         Int?     @map("page_start")
  pageEnd           Int?     @map("page_end")
  orderIndex        Int      @map("order_index")
  sourceLocation    Json?    @map("source_location")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  version  DocumentVersion   @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  parent   DocumentSection?  @relation("SectionTree", fields: [parentSectionId], references: [id], onDelete: Cascade)
  children DocumentSection[] @relation("SectionTree")
  chunks   DocumentChunk[]

  @@unique([documentVersionId, orderIndex])
  @@index([parentSectionId])
  @@map("document_sections")
}

model DocumentChunk {
  id                String              @id @default(cuid())
  documentVersionId String              @map("document_version_id")
  documentSectionId String?             @map("document_section_id")
  chunkIndex        Int                 @map("chunk_index")
  content           String
  tokenCount        Int                 @map("token_count")
  pageStart         Int?                @map("page_start")
  pageEnd           Int?                @map("page_end")
  sourceLocation    Json?               @map("source_location")
  contentHash       String              @map("content_hash")
  chunkingVersion   String              @map("chunking_version")
  embeddingStatus   ProcessingJobStatus @default(PENDING) @map("embedding_status")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  version DocumentVersion  @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  section DocumentSection? @relation(fields: [documentSectionId], references: [id], onDelete: SetNull)

  @@unique([documentVersionId, chunkingVersion, chunkIndex])
  @@unique([documentVersionId, chunkingVersion, contentHash])
  @@map("document_chunks")
}

model Taxonomy {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  terms TaxonomyTerm[]

  @@map("taxonomies")
}

model TaxonomyTerm {
  id           String   @id @default(cuid())
  taxonomyId   String   @map("taxonomy_id")
  parentTermId String?  @map("parent_term_id")
  key          String
  label        String
  description  String?
  metadata     Json?
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  taxonomy  Taxonomy               @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  parent    TaxonomyTerm?          @relation("TaxonomyTree", fields: [parentTermId], references: [id], onDelete: SetNull)
  children  TaxonomyTerm[]         @relation("TaxonomyTree")
  documents DocumentTaxonomyTerm[]

  @@unique([taxonomyId, key])
  @@map("taxonomy_terms")
}

model DocumentTaxonomyTerm {
  id                String    @id @default(cuid())
  documentId        String    @map("document_id")
  taxonomyTermId    String    @map("taxonomy_term_id")
  source            String
  confidenceScore   Decimal?  @map("confidence_score") @db.Decimal(5, 4)
  isValidated       Boolean   @default(false) @map("is_validated")
  validatedByUserId String?   @map("validated_by_user_id")
  validatedAt       DateTime? @map("validated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  document    Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  term        TaxonomyTerm @relation(fields: [taxonomyTermId], references: [id], onDelete: Restrict)
  validatedBy User?        @relation("DocumentTaxonomyValidator", fields: [validatedByUserId], references: [id], onDelete: SetNull)

  @@unique([documentId, taxonomyTermId, source])
  @@map("document_taxonomy_terms")
}

model DocumentMetadataSuggestion {
  id                String    @id @default(cuid())
  documentVersionId String    @map("document_version_id")
  fieldName         String    @map("field_name")
  suggestedValue    Json      @map("suggested_value")
  confidenceScore   Decimal   @map("confidence_score") @db.Decimal(5, 4)
  sourcePage        Int?      @map("source_page")
  sourceText        String?   @map("source_text")
  decision          String    @default("pending")
  reviewedByUserId  String?   @map("reviewed_by_user_id")
  reviewedAt        DateTime? @map("reviewed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  version    DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  reviewedBy User?           @relation("DocumentMetadataSuggestionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([documentVersionId, fieldName])
  @@map("document_metadata_suggestions")
}

model DocumentReview {
  id                String       @id @default(cuid())
  documentVersionId String       @map("document_version_id")
  status            ReviewStatus @default(NOT_STARTED)
  assignedToUserId  String?      @map("assigned_to_user_id")
  createdByUserId   String       @map("created_by_user_id")
  notes             String?
  startedAt         DateTime?    @map("started_at")
  completedAt       DateTime?    @map("completed_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  version    DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  assignedTo User?           @relation("DocumentReviewAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy  User            @relation("DocumentReviewCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([status, assignedToUserId])
  @@map("document_reviews")
}

model DocumentReviewIssue {
  id                String              @id @default(cuid())
  documentVersionId String              @map("document_version_id")
  processingJobId   String?             @map("processing_job_id")
  issueType         String              @map("issue_type")
  severity          ReviewIssueSeverity
  status            ReviewIssueStatus   @default(OPEN)
  title             String
  description       String
  sourceLocation    Json?               @map("source_location")
  assignedToUserId  String?             @map("assigned_to_user_id")
  createdByUserId   String              @map("created_by_user_id")
  resolvedByUserId  String?             @map("resolved_by_user_id")
  resolvedAt        DateTime?           @map("resolved_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  version       DocumentVersion        @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  processingJob DocumentProcessingJob? @relation(fields: [processingJobId], references: [id], onDelete: SetNull)
  assignedTo    User?                  @relation("DocumentReviewIssueAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy     User                   @relation("DocumentReviewIssueCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  resolvedBy    User?                  @relation("DocumentReviewIssueResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([documentVersionId, status, severity])
  @@map("document_review_issues")
}

model DocumentActivity {
  id                String   @id @default(cuid())
  documentId        String   @map("document_id")
  documentVersionId String?  @map("document_version_id")
  actorUserId       String?  @map("actor_user_id")
  organizationId    String?  @map("organization_id")
  action            String
  ipAddress         String?  @map("ip_address")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")

  document Document         @relation(fields: [documentId], references: [id], onDelete: Restrict)
  version  DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  actor    User?            @relation("DocumentActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([action, createdAt])
  @@map("document_activity_log")
}

model Session {
  id                   String   @id @default(uuid())
  token                String   @unique
  expiresAt            DateTime @map("expires_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id")
  activeOrganizationId String?  @map("active_organization_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logo        String?
  icon        String?
  metadata    String?
  status      String   @default("active")
  countryCode String   @default("MA") @map("country_code")
  locale      String   @default("fr-MA")
  timezone    String   @default("Africa/Casablanca")
  createdAt   DateTime @default(now()) @map("created_at")

  members           Member[]
  invitations       Invitation[]
  sites             Site[]
  projects          Project[]
  auditCampaigns    AuditCampaign[]
  audits            Audit[]
  standardDocuments StandardDocument[]
  standardVersions  StandardVersion[]
  clauses           Clause[]
  requirements      Requirement[]
  evidence          Evidence[]
  findings          Finding[]
  correctiveActions CorrectiveAction[]
  files             FileObject[]
  backgroundJobs    BackgroundJob[]
  auditLogEntries   AuditLogEntry[]

  @@map("organizations")
}

model Member {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           String   @default("member")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String   @id @default(uuid())
  email          String
  inviterId      String   @map("inviter_id")
  organizationId String   @map("organization_id")
  role           String?
  status         String
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@map("invitations")
}

model Site {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String
  address        String?
  tags           String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  audits       Audit[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@index([organizationId, deletedAt])
  @@map("sites")
}

model Project {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  createdById    String            @map("created_by_id")
  name           String
  slug           String
  logoUrl        String?           @map("logo_url")
  entityType     ProjectEntityType @map("entity_type")
  countryCode    String            @default("MA") @map("country_code")
  standardCode   String            @default("ISO_9001") @map("standard_code")
  description    String?
  status         ProjectStatus     @default(EMPTY)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  archivedAt     DateTime?         @map("archived_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  activities   ProjectActivity[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([createdById])
  @@index([status])
  @@map("projects")
}

model ProjectActivity {
  id             String   @id @default(cuid())
  projectId      String   @map("project_id")
  name           String
  normalizedName String   @map("normalized_name")
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, normalizedName])
  @@index([projectId])
  @@map("project_activities")
}

model AuditCampaign {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  audits       Audit[]

  @@unique([organizationId, name, startsAt])
  @@index([organizationId, startsAt])
  @@map("audit_campaigns")
}

model Audit {
  id             String      @id @default(cuid())
  organizationId String
  siteId         String
  campaignId     String?
  title          String
  status         AuditStatus @default(DRAFT)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  campaign     AuditCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  evidence     Evidence[]
  findings     Finding[]

  @@index([organizationId, status])
  @@index([organizationId, siteId])
  @@map("audits")
}

model StandardDocument {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  title          String
  publisher      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     StandardVersion[]

  @@unique([organizationId, code])
  @@map("standard_documents")
}

model StandardVersion {
  id                 String    @id @default(cuid())
  organizationId     String
  standardDocumentId String
  version            String
  publishedAt        DateTime?
  effectiveAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  standardDocument StandardDocument @relation(fields: [standardDocumentId], references: [id], onDelete: Restrict)
  clauses          Clause[]

  @@unique([organizationId, standardDocumentId, version])
  @@index([organizationId])
  @@map("standard_versions")
}

model Clause {
  id                String                       @id @default(cuid())
  organizationId    String
  standardVersionId String
  reference         String
  title             String?
  content           String
  embedding         Unsupported("vector(1536)")?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  standardVersion StandardVersion @relation(fields: [standardVersionId], references: [id], onDelete: Cascade)
  requirements    Requirement[]

  @@unique([organizationId, standardVersionId, reference])
  @@index([organizationId])
  @@map("clauses")
}

model Requirement {
  id             String   @id @default(cuid())
  organizationId String
  clauseId       String
  code           String
  text           String
  activities     String[] @default([])
  weight         Decimal  @default(1) @db.Decimal(8, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clause       Clause       @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  evidence     Evidence[]
  findings     Finding[]

  @@unique([organizationId, clauseId, code])
  @@index([organizationId])
  @@map("requirements")
}

model Evidence {
  id               String                       @id @default(cuid())
  organizationId   String
  auditId          String
  requirementId    String?
  fileId           String?
  kind             EvidenceKind
  summary          String?
  assessmentResult AssessmentResult             @default(NOT_ASSESSED)
  embedding        Unsupported("vector(1536)")?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  audit        Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  requirement  Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  file         FileObject?  @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([organizationId, auditId])
  @@index([organizationId, requirementId])
  @@map("evidence")
}

model Finding {
  id             String          @id @default(cuid())
  organizationId String
  auditId        String
  requirementId  String?
  title          String
  description    String
  severity       FindingSeverity
  status         FindingStatus   @default(OPEN)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  audit             Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)
  requirement       Requirement?       @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  correctiveActions CorrectiveAction[]

  @@index([organizationId, auditId])
  @@index([organizationId, severity, status])
  @@map("findings")
}

model CorrectiveAction {
  id             String                 @id @default(cuid())
  organizationId String
  findingId      String
  title          String
  assigneeId     String?
  dueAt          DateTime
  status         CorrectiveActionStatus @default(OPEN)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  finding      Finding      @relation(fields: [findingId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([organizationId, findingId])
  @@map("corrective_actions")
}

model FileObject {
  id             String    @id @default(cuid())
  organizationId String
  objectKey      String
  originalName   String
  contentType    String
  sizeBytes      BigInt
  checksum       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  evidence     Evidence[]

  @@unique([organizationId, objectKey])
  @@index([organizationId, deletedAt])
  @@map("files")
}

model BackgroundJob {
  id             String    @id @default(cuid())
  organizationId String
  queue          String
  jobName        String
  externalJobId  String?
  correlationId  String
  idempotencyKey String
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  lastErrorCode  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, queue, idempotencyKey])
  @@index([organizationId, status])
  @@map("background_jobs")
}

model AuditLogEntry {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  requestId      String?
  ipAddress      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_log_entries")
}
