generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum AuditStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum AssessmentResult {
  CONFORMING
  PARTIAL
  NON_CONFORMING
  NOT_ASSESSED
}

enum EvidenceKind {
  DOCUMENT
  PHOTO
  NOTE
  LINK
}

enum FindingSeverity {
  OBSERVATION
  MINOR
  MAJOR
  CRITICAL
}

enum FindingStatus {
  OPEN
  IN_PROGRESS
  VERIFIED
  CLOSED
}

enum CorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  VERIFIED
}

enum JobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
}

enum DocumentStatus {
  DRAFT
  UPLOADED
  PROCESSING
  REVIEW_REQUIRED
  VALIDATED
  PUBLISHED
  PROCESSING_FAILED
  ARCHIVED
}

