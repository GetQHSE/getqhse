  evaluation          RegulatoryEvaluation           @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  carriedFromEvidence RegulatoryEvaluationEvidence?  @relation("RegulatoryEvidenceLineage", fields: [carriedFromEvidenceId], references: [id], onDelete: SetNull)
  carriedEvidence     RegulatoryEvaluationEvidence[] @relation("RegulatoryEvidenceLineage")
  file                FileObject?                    @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdBy           User                           @relation("RegulatoryEvidenceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([evaluationId, createdAt])
  @@map("regulatory_evaluation_evidence")
}

model RegulatoryEvaluationAction {
  id                    String                  @id @default(cuid())
  evaluationId          String                  @map("evaluation_id")
  carriedFromActionId   String?                 @map("carried_from_action_id")
  title                 String
  assigneeId            String?                 @map("assignee_id")
  resources             String?
  dueDate               DateTime?               @map("due_date") @db.Date
  completedDate         DateTime?               @map("completed_date") @db.Date
  status                RegulatoryActionStatus  @default(OPEN)
  effectivenessCriteria String?                 @map("effectiveness_criteria")
  effectiveness         RegulatoryEffectiveness @default(PENDING)
  comment               String?
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  evaluation        RegulatoryEvaluation         @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  carriedFromAction RegulatoryEvaluationAction?  @relation("RegulatoryActionLineage", fields: [carriedFromActionId], references: [id], onDelete: SetNull)
  carriedActions    RegulatoryEvaluationAction[] @relation("RegulatoryActionLineage")
  assignee          User?                        @relation("RegulatoryActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([evaluationId, status])
  @@index([assigneeId, dueDate])
  @@map("regulatory_evaluation_actions")
}

model RegulatorySyncEvent {
  id                 String                    @id @default(cuid())
  documentId         String                    @map("document_id")
  previousVersionId  String                    @map("previous_version_id")
  publishedVersionId String                    @unique @map("published_version_id")
  actorUserId        String                    @map("actor_user_id")
  status             RegulatorySyncEventStatus @default(PENDING)
  attempts           Int                       @default(0)
  affectedWatchCount Int                       @default(0) @map("affected_watch_count")
  lastError          String?                   @map("last_error")
  processedAt        DateTime?                 @map("processed_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  document         Document        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  previousVersion  DocumentVersion @relation("RegulatorySyncPreviousVersion", fields: [previousVersionId], references: [id], onDelete: Restrict)
  publishedVersion DocumentVersion @relation("RegulatorySyncPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  actor            User            @relation("RegulatorySyncEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("regulatory_sync_events")
}

model ProjectProfileConversation {
  id                 String                    @id @default(cuid())
  profileId          String                    @map("profile_id")
  status             ProfileConversationStatus @default(ACTIVE)
  language           String                    @default("fr")
  currentQuestionKey String?                   @map("current_question_key")
  module             String                    @default("PROFILE_COMPLETION")
  createdById        String                    @map("created_by_id")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  profile       ProjectProfile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdBy     User                    @relation("ProfileConversationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  messages      ProjectProfileMessage[]
  aiInvocations AiInvocation[]

  @@index([profileId, status])
  @@map("project_profile_conversations")
}

model ProjectProfileMessage {
  id               String             @id @default(cuid())
  conversationId   String             @map("conversation_id")
  role             ProfileMessageRole
  content          String
  clientMessageId  String?            @map("client_message_id")
  replyToMessageId String?            @map("reply_to_message_id")
  parts            Json?
  model            String?
  promptKey        String?            @map("prompt_key")
  promptVersion    Int?               @map("prompt_version")
  inputTokens      Int?               @map("input_tokens")
  outputTokens     Int?               @map("output_tokens")
  createdAt        DateTime           @default(now()) @map("created_at")

  conversation ProjectProfileConversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  ProjectProfileMessageAttachment[]

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([replyToMessageId])
  @@map("project_profile_messages")
}

model ProjectProfileMessageAttachment {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  fileId    String   @map("file_id")
  createdAt DateTime @default(now()) @map("created_at")

  message ProjectProfileMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    FileObject            @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([messageId, fileId])
  @@index([fileId])
  @@map("project_profile_message_attachments")
}

model AiInvocation {
  id                 String             @id @default(cuid())
  organizationId     String             @map("organization_id")
  projectId          String?            @map("project_id")
  profileId          String?            @map("profile_id")
  conversationId     String?            @map("conversation_id")
  module             String
  task               String
  promptKey          String             @map("prompt_key")
  promptVersion      Int                @map("prompt_version")
  model              String
  inputSchemaVersion Int?               @map("input_schema_version")
  inputHash          String             @map("input_hash")
  outputHash         String?            @map("output_hash")
  toolNames          String[]           @default([]) @map("tool_names")
  inputTokens        Int?               @map("input_tokens")
  outputTokens       Int?               @map("output_tokens")
  latencyMs          Int?               @map("latency_ms")
  status             AiInvocationStatus @default(RUNNING)
  errorCode          String?            @map("error_code")
  createdAt          DateTime           @default(now()) @map("created_at")
  completedAt        DateTime?          @map("completed_at")

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?                    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  profile      ProjectProfile?             @relation(fields: [profileId], references: [id], onDelete: SetNull)
  conversation ProjectProfileConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([module, task, createdAt])
  @@map("ai_invocations")
}

model AuditCampaign {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  audits       Audit[]

  @@unique([organizationId, name, startsAt])
  @@index([organizationId, startsAt])
  @@map("audit_campaigns")
}

model Audit {
  id             String      @id @default(cuid())
  organizationId String
  siteId         String
  campaignId     String?
  title          String
  status         AuditStatus @default(DRAFT)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  campaign     AuditCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  evidence     Evidence[]
  findings     Finding[]

  @@index([organizationId, status])
  @@index([organizationId, siteId])
  @@map("audits")
}

model Evidence {
  id               String           @id @default(cuid())
  organizationId   String
  auditId          String
  fileId           String?
  kind             EvidenceKind
  summary          String?
  assessmentResult AssessmentResult @default(NOT_ASSESSED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  audit        Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  file         FileObject?  @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([organizationId, auditId])
  @@map("evidence")
}

model Finding {
  id             String          @id @default(cuid())
  organizationId String
  auditId        String
  title          String
  description    String
  severity       FindingSeverity
  status         FindingStatus   @default(OPEN)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  audit             Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)
  correctiveActions CorrectiveAction[]

  @@index([organizationId, auditId])
  @@index([organizationId, severity, status])
  @@map("findings")
}

model CorrectiveAction {
  id             String                 @id @default(cuid())
  organizationId String
  findingId      String
  title          String
  assigneeId     String?
  dueAt          DateTime
  status         CorrectiveActionStatus @default(OPEN)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  finding      Finding      @relation(fields: [findingId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([organizationId, findingId])
  @@map("corrective_actions")
}

model FileObject {
  id             String           @id @default(cuid())
  organizationId String
  objectKey      String
  originalName   String
  contentType    String
  sizeBytes      BigInt
  checksum       String
  purpose        FilePurpose      @default(CHAT_ATTACHMENT)
  uploadStatus   FileUploadStatus @default(PENDING) @map("upload_status")
  uploadedById   String?          @map("uploaded_by_id")
  verifiedAt     DateTime?        @map("verified_at")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization              Organization                      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy                User?                             @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  evidence                  Evidence[]
  profileMessageAttachments ProjectProfileMessageAttachment[]
  transcriptions            FileTranscription[]
  regulatoryEvidence        RegulatoryEvaluationEvidence[]

  @@unique([organizationId, objectKey])
  @@index([organizationId, deletedAt])
  @@map("files")
}

model FileTranscription {
  id          String              @id @default(cuid())
  fileId      String              @map("file_id")
  model       String
  language    String?
  text        String?
  durationMs  Int?                @map("duration_ms")
  status      TranscriptionStatus @default(PENDING)
  errorCode   String?             @map("error_code")
  createdAt   DateTime            @default(now()) @map("created_at")
  completedAt DateTime?           @map("completed_at")

  file FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, model])
  @@index([status, createdAt])
  @@map("file_transcriptions")
}

model BackgroundJob {
  id             String    @id @default(cuid())
  organizationId String
  queue          String
  jobName        String
  externalJobId  String?
  correlationId  String
  idempotencyKey String
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  lastErrorCode  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, queue, idempotencyKey])
  @@index([organizationId, status])
  @@map("background_jobs")
}

model AuditLogEntry {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  requestId      String?
  ipAddress      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_log_entries")
}
