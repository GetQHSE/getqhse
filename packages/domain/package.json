{
  "name": "@qhse/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./smq/context/method": {
      "types": "./dist/smq/context/method.d.ts",
      "default": "./dist/smq/context/method.js"
    },
    "./smq/context/labels": {
      "types": "./dist/smq/context/labels.d.ts",
      "default": "./dist/smq/context/labels.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.10.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
